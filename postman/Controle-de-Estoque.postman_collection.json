        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Teclado USB\",\n  \"description\": \"Produto de demonstracao\",\n  \"code\": \"DEMO-{{email}}\",\n  \"price\": 49.9,\n  \"quantity\": 10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('product_id', pm.response.json().data.id);",
              "pm.test('Saldo inicial 10', function () { pm.expect(pm.response.json().data.quantity).to.eql(10); });"
            ]
          }
        }
      ]
    },
